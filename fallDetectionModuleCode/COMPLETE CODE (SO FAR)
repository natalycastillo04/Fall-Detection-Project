#include <Adafruit_NeoPixel.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Wire.h>

// Buzzer
const int buzzerPin = 8;

// SOS
const int cancelButtonPin = 3;
bool sosMode = false;
const int DOT = 150;
const int DASH = 450;
const int GAP = 150;
void blueFlash(int time);
void playSOS();

//UltraSonic Sensor
const int echoPin = 10;
const int trigPin = 9;
const int motionThresh = 20;
float motionDetect();

// Automatic LED LightBar
const int ledPin = 11;
const int numPixels = 8;
const int ldrPin = A0;
const int darkThresh = 200;
Adafruit_NeoPixel pixels(numPixels, ledPin, NEO_GRBW + NEO_KHZ800);
void neopixelStick(int lightLevel, float distance);
void strobe();


// Accelerometer
Adafruit_MPU6050 acc; 
const float freeFallThresh = 0.45;
float accelMag = 1.0;
bool fallDetect();

// Button
const int buttonPin = 2;
bool lastButtonState;
bool systemOn = false;

void serialMonitor(int lightLevel, float distance, bool fall);
// SETUP
void setup() 
{
  Serial.begin(9600);

  // Button
  pinMode(buttonPin, INPUT_PULLUP);
  lastButtonState = digitalRead(buttonPin);

  // SOS
  pinMode(cancelButtonPin, INPUT_PULLUP);

  // LED Bar Setup
  pixels.begin();
  pixels.clear();
  pixels.show();

  // Set middle two pixels green for "on" state
  pixels.setPixelColor(3, pixels.Color(0, 255, 0));
  pixels.setPixelColor(4, pixels.Color(0, 255, 0));
  pixels.setBrightness(150);
  pixels.show();

  // Ultrasonic Sensor setup
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

// Accelerometer Setup
  pinMode(buzzerPin, OUTPUT);

  if (!acc.begin()) 
  {
    Serial.println("MPU6050 not found!");
    while (1);
  }
  
  acc.setAccelerometerRange(MPU6050_RANGE_4_G);
  acc.setGyroRange(MPU6050_RANGE_500_DEG);
  acc.setFilterBandwidth(MPU6050_BAND_21_HZ);
}

// LOOP
void loop()
{
  // ---------- Button Toggle ----------
  bool buttonState = digitalRead(buttonPin);

  // Detect a new button press
  if (lastButtonState == HIGH && buttonState == LOW)
  {
    systemOn = !systemOn;   // Toggle ON/OFF

    if (systemOn)
      Serial.println("SYSTEM ON");
    else
    {
      Serial.println("SYSTEM OFF");
      noTone(buzzerPin);
      pixels.clear();
      pixels.show();
    }

    delay(50);   // Simple debounce
  }

  lastButtonState = buttonState;

  // If OFF, do nothing
  if (!systemOn)
  {
    return;
  }

  if (sosMode)
  {
    playSOS();

    if (digitalRead(cancelButtonPin) == LOW)
    {
        sosMode = false;
        pixels.clear();
        pixels.show();
        noTone(buzzerPin);
    }

    return;
  }

  // ---------- Your Original Code ----------
  float distance = motionDetect();
  int lightLevel = analogRead(ldrPin);
  bool fall = fallDetect();

  neopixelStick(lightLevel, distance);

 
  static bool lastFall = false;

  if (fall && !lastFall)
  {
      Serial.println("FREE FALL DETECTED!");
      sosMode = true;
  }

  lastFall = fall;
  

  serialMonitor(lightLevel, distance, fall);

  delay(10);
}

void blueFlash(int time)
{
    for (int i = 0; i < numPixels; i++)
        pixels.setPixelColor(i, pixels.Color(0,0,255));

    pixels.show();

    tone(buzzerPin,1000);

    delay(time);

    pixels.clear();
    pixels.show();

    noTone(buzzerPin);

    delay(GAP);
}

void playSOS()
{
    // S
    blueFlash(DOT);
    blueFlash(DOT);
    blueFlash(DOT);

    delay(300);

    // O
    blueFlash(DASH);
    blueFlash(DASH);
    blueFlash(DASH);

    delay(300);

    // S
    blueFlash(DOT);
    blueFlash(DOT);
    blueFlash(DOT);

    delay(1000);
}

// LED Bar
void neopixelStick(int lightLevel, float distance)
{
  // Motion detected: flash red and buzz
  if (distance <= motionThresh)
  {
    strobe();
    return;
  }

  // Motion stopped: make sure buzzer is off
  noTone(buzzerPin);

  // Dark: solid white LEDs
  if (lightLevel < darkThresh)
  {
    for (int i = 0; i < numPixels; i++)
    {
      pixels.setPixelColor(i, pixels.Color(0, 0, 0, 255));
    }

    pixels.setBrightness(150);
    pixels.show();
  }
  // Bright: only middle green LEDs
  else
  {
    pixels.clear();
    pixels.setPixelColor(3, pixels.Color(0, 255, 0));
    pixels.setPixelColor(4, pixels.Color(0, 255, 0));
    pixels.setBrightness(50);
    pixels.show();
  }
}

// Ultrasonic Sensor
float motionDetect()
{
  float distance;
  long duration;

  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH, 30000);
  distance = (0.0343 * duration) / 2;

  if (distance == 0)
  {
    return 999;
  }

  return distance;
}

// ACCEL
bool fallDetect()
{
  sensors_event_t a, g, temp;
  acc.getEvent(&a, &g, &temp);

  float ax = a.acceleration.x / 9.81;
  float ay = a.acceleration.y / 9.81;
  float az = a.acceleration.z / 9.81;

  accelMag = sqrt(ax * ax + ay * ay + az * az);

  return (accelMag <= freeFallThresh);
}

void strobe()
{
  static bool on = false;
  static unsigned long lastFlash = 0;

  if (millis() - lastFlash >= 75)
  {
    lastFlash = millis();
    on = !on;

    if (on)
    {
      for (int i = 0; i < numPixels; i++)
        pixels.setPixelColor(i, pixels.Color(255, 0, 0));

      tone(buzzerPin, 1000);   // Buzzer ON
    }
    else
    {
      pixels.clear();
      noTone(buzzerPin);       // Buzzer OFF
    }

    pixels.show();
  }
}


void serialMonitor(int lightLevel, float distance, bool fall)
{
  Serial.print("LDR: ");
  Serial.print(lightLevel);

  Serial.print(" | Distance: ");
  Serial.print(distance, 1);
  Serial.print(" cm");

  Serial.print(" | Light: ");
  if (lightLevel < darkThresh)
    Serial.print("WHITE");
  else
    Serial.print("GREEN");

  Serial.print(" | Motion: ");
  if (distance <= motionThresh)
    Serial.print("YES");
  else
    Serial.print("NO");

  Serial.print(" | Accel: ");
  Serial.print(accelMag, 2);
  Serial.print(" g");

  Serial.print(" | Fall: ");
  if (fall)
    Serial.println("YES");
  else
    Serial.println("NO");
}
